{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/native/CodexPetPlugin.exe\" --ensure --plugin-root \"${PLUGIN_ROOT}\"",
            "statusMessage": "正在启动额度伙伴"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/native/CodexPetPlugin.exe\" --ensure --plugin-root \"${PLUGIN_ROOT}\"",
            "statusMessage": "正在确认额度伙伴状态"
          }
        ]
      }
    ]
  }
}
